APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PERSEDIAAN_DB_HOST=127.0.0.1
# PERSEDIAAN_DB_PORT=3306
# PERSEDIAAN_DB_DATABASE=persediaan
# PERSEDIAAN_DB_USERNAME=root
# PERSEDIAAN_DB_PASSWORD=

# KEPEGAWAIAN_DB_HOST=127.0.0.1
# KEPEGAWAIAN_DB_PORT=3306
# KEPEGAWAIAN_DB_DATABASE=kepegawaian
# KEPEGAWAIAN_DB_USERNAME=root
# KEPEGAWAIAN_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# RapatKita Google Sheets mirror (backup baca saat server offline)
RAPATKITA_SHEETS_ENABLED=false
RAPATKITA_SHEETS_CREDENTIALS_PATH=
RAPATKITA_SHEETS_ID=
RAPATKITA_SHEETS_SHARE_EMAIL=

# Arsip Digital — Google Drive storage
#
# auth_mode:
#   oauth            = Gmail gratis OK. File Drive masuk ke akun user biasa
#                      yang kamu koneksikan lewat /arsip/connect-google SEKALI.
#   service_account  = butuh Google Workspace. SA gratisan tidak bisa upload
#                      file (HTTP 403 storageQuotaExceeded).
ARSIP_DRIVE_AUTH_MODE=oauth
ARSIP_DRIVE_OAUTH_CLIENT_ID=
ARSIP_DRIVE_OAUTH_CLIENT_SECRET=
ARSIP_DRIVE_OAUTH_REFRESH_TOKEN=
ARSIP_DRIVE_OAUTH_REDIRECT_URI=http://localhost:8080/arsip/oauth/callback
ARSIP_DRIVE_CREDENTIALS_PATH=
ARSIP_DRIVE_FOLDER_ID=
# Folder penampung berkas belum ter-approve (di dalam folder ARSIP_DRIVE_FOLDER_ID).
# Saat approve, berkas dipindah ke subfolder "YYYY-MM-DD - Judul" baru di folder induk.
ARSIP_DRIVE_ETC_FOLDER_ID=
ARSIP_MAX_UPLOAD_KB=51200
