# Arsip Digital — penyimpanan disk lokal (ganti Google Drive)
# Kosongkan/relatif = default storage/app/private/arsip. Di produksi arahkan
# ke volume mount Docker, mis. /var/www/storage/arsip.
ARSIP_LOCAL_ROOT=/var/www/storage/arsip
ARSIP_MAX_UPLOAD_KB=51200