# Contoh env untuk stack mandiri (docker-compose.mandiri.yml).
# Salin jadi docker/mandiri.env lalu isi yang kosong:
#   cp docker/mandiri.env.example docker/mandiri.env
# File ini KHUSUS lokal — jangan samakan dengan src/.env (production).

# Diisi otomatis oleh ./jalan.sh up bila masih kosong.
APP_KEY=

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# Database utama (dibuat otomatis oleh init.sql).
DB_DATABASE=dpmptsp_new
DB_USERNAME=root
DB_PASSWORD=rahasia

# Database kepegawaian (dibuat otomatis oleh init.sql).
KEPEGAWAIAN_DB_DATABASE=kepegawaian
KEPEGAWAIAN_DB_USERNAME=root
KEPEGAWAIAN_DB_PASSWORD=rahasia

# Modul lain ikut menumpang di database utama (tabelnya dibuat oleh migrate).
PERSEDIAAN_DB_DATABASE=dpmptsp_new
BANGKIT_DB_DATABASE=dpmptsp_new

# Login pakai Google OAuth — wajib diisi dari Google Cloud Console.
# Redirect URI yang didaftarkan: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT=http://localhost:8080/auth/google/callback
